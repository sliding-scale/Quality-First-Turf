# The deployment name (CONVEX_DEPLOYMENT) is not here: it lives in the repo-root .env.local, written by `npx convex dev` run from the repo root.
NEXT_PUBLIC_CONVEX_URL=

# Set these on the Convex deployment, not here:
#   npx convex env set SALES_EMAIL you@example.com
#   npx convex env set SALES_PASSWORD ...
#   npx convex env set SALES_NAME "Jane Doe"          (optional display name for the shared login)
#   npx convex env set SALES_ACCOUNTS '[{"email":"a@x.com","password":"...","name":"A Name"}]'
#   npx convex env set JOBBER_CLIENT_ID ...
#   npx convex env set JOBBER_CLIENT_SECRET ...
#   npx convex env set JOBBER_CONNECT_KEY ...
